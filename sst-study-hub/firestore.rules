rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unique username registry for ensuring no duplicate accounts
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.resource.data.username == username;
      allow update, delete: if true;
    }

    // Secure user documents
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.uid == userId;
      allow update, delete: if true;
    }

    // Diagnostic connection verification
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
